# Generated by Cargo
# will have compiled files and executables
/debug/
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Cargo.lock IS committed: Luna rebuilds itself on the user's machine when a tool is
# added (see docs/ARCHITECTURE.md §3), so dependency resolution must not drift.
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
/FORTESTING

# Runtime data, created next to the executable. Never committed.
/config/
/data/
/logs/
luna_app.prev.exe
/.claude

# Drafted GitHub issues, staged locally before being filed by hand.
/issues/
