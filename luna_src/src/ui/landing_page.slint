import { SideBar, SidebarEntry } from "../helpers/sidebar_component.slint";
import { Button, CheckBox, StandardListView, Palette } from "std-widgets.slint";
import { LunaLibraryGlobalSettings } from "..\helpers\gallery_settings.slint";

// Generated by build.rs from whatever is in tools/, and found through an include
// path. Holds one page per discovered tool, keyed by tool id.
import { ToolPages } from "tool_pages.slint";

export { Global_NumberConversion_Callback, Global_Calendar_Callback } from "..\helpers\global_callbacks.slint";
export { SidebarEntry }

export component LunaAppUi inherits Window {
    preferred-width: 700px;
    preferred-height: 500px;
    title: @tr("Luna Widget Library");

    // Populated from the tool registry at startup. Enabling or disabling a tool
    // rewrites this list; nothing here is hardcoded.
    in property <[SidebarEntry]> tools: [];

    // Which tool page is showing. Set at startup to restore the last active tool,
    // and read back on exit to record it.
    in-out property <int> current-tool-index: 0;
    out property <string> current-tool-id: side-bar.current-id;

    // Set when the tools folder holds something this build does not. Empty hides the
    // banner, so there is no separate visibility flag to keep in sync.
    in property <string> tool-change-notice: "";
    // Whether a rebuild is actually possible here. When it is not, the banner explains
    // rather than offering a button that would fail.
    in property <bool> can-rebuild: false;

    callback rebuild-requested();
    callback dismiss-notice();

    // icon: @image-url("../../logo/slint-logo-small-light.png");

    MenuBar {
    }

    VerticalLayout {

    if root.tool-change-notice != "" : Rectangle {
        height: 44px;
        background: Palette.alternate-background;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;

            Text {
                text: root.tool-change-notice;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                color: Palette.foreground;
            }

            if root.can-rebuild : Button {
                text: @tr("Rebuild and restart");
                primary: true;
                clicked => { root.rebuild-requested(); }
            }

            Button {
                text: @tr("Not now");
                clicked => { root.dismiss-notice(); }
            }
        }
    }

    HorizontalLayout {
        side-bar := SideBar {
            title: @tr("Luna Widgets Library");
            model: root.tools;
            current-item <=> root.current-tool-index;
        }

        if side-bar.current-id != "" : ToolPages {
            current-tool-id: side-bar.current-id;
        }

        if side-bar.current-id == "" : Rectangle {
            background: Palette.background;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: @tr("No tools are enabled");
                    font-size: 18px;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }

                Text {
                    text: @tr("Enable a tool to get started.");
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.7;
                }
            }
        }
    }

    }
}
