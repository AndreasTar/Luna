import { SideBar, SidebarEntry } from "../helpers/sidebar_component.slint";
import { Button, CheckBox, StandardListView, Palette } from "std-widgets.slint";
import { Theme } from "../helpers/theme.slint";
import { LunaLibraryGlobalSettings } from "..\helpers\gallery_settings.slint";

// Generated by build.rs from whatever is in tools/, and found through an include
// path. Holds one page per discovered tool, keyed by tool id.
import { ToolPages } from "tool_pages.slint";
import { PalettePicker, PaletteEntry } from "../helpers/palette_picker.slint";
import { IconButton } from "../helpers/icon_button.slint";

export { Global_NumberConversion_Callback, Global_Calendar_Callback, Global_Calendar_Data } from "..\helpers\global_callbacks.slint";

// The shapes the calendar's models travel in. Re-exported so Rust gets generated types
// to build them with; a struct only reachable through an import is not enough.
export { DayCell, MonthCell, HourCell, EventCell, UpcomingEventsCell, EventDraft } from "..\helpers\global_callbacks.slint";

// Re-exported so Rust can push the resolved palette into it. A global is only visible
// to Rust if the root file exports it, which is what made the calendar's callbacks
// unreachable before.
export { Theme }

export { SidebarEntry, PaletteEntry }

export component LunaAppUi inherits Window {
    preferred-width: 700px;
    preferred-height: 500px;
    title: @tr("Luna Widget Library");

    // Populated from the tool registry at startup. Enabling or disabling a tool
    // rewrites this list; nothing here is hardcoded.
    in property <[SidebarEntry]> tools: [];

    // Which tool page is showing. Set at startup to restore the last active tool,
    // and read back on exit to record it.
    in-out property <int> current-tool-index: 0;
    out property <string> current-tool-id: side-bar.current-id;

    // Set when the tools folder holds something this build does not. Empty hides the
    // banner, so there is no separate visibility flag to keep in sync.
    in property <string> tool-change-notice: "";
    // Whether a rebuild is actually possible here. When it is not, the banner explains
    // rather than offering a button that would fail.
    in property <bool> can-rebuild: false;

    callback rebuild-requested();
    callback dismiss-notice();

    // Fires when the visible tool changes, so Rust can reapply that tool's palette.
    // Slint has no change handler on a property, so this hangs off the same selection
    // the page chain uses.
    callback tool-changed(string);

    // Palette picker. Settings live in the shell rather than in a tool, because they
    // configure the shell itself.
    in property <[PaletteEntry]> palettes: [];
    in property <string> active-palette-id;
    in property <string> palettes-folder;
    in-out property <bool> showing-settings: false;
    callback palette-chosen(string);

    // The quit prompt. Shown only when closing would stop something; an idle Luna
    // closes without asking.
    in property <bool> showing-quit-prompt: false;
    in property <string> quit-headline;
    in property <[string]> quit-lines;
    in property <bool> has-tray: false;
    callback confirm-quit();
    callback cancel-quit();
    callback minimise-to-tray();

    // icon: @image-url("../../logo/slint-logo-small-light.png");

    MenuBar {
    }

    if root.showing-quit-prompt : Rectangle {
        background: Theme.background.darker(0.3);

        // Swallows clicks so the app behind cannot be operated while the prompt is up.
        TouchArea {}

        Rectangle {
            width: min(root.width - 60px, 520px);
            height: prompt-layout.preferred-height;
            background: Theme.background-secondary;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;

            prompt-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: @tr("Close Luna?");
                    font-size: 18px;
                    font-weight: FontWeight.semi-bold;
                    color: Theme.text;
                }

                Text {
                    text: root.quit-headline;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                for line in root.quit-lines : Text {
                    text: "  " + line;
                    font-size: 12px;
                    color: Theme.warning;
                    wrap: word-wrap;
                }

                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: @tr("Cancel");
                        clicked => { root.cancel-quit(); }
                    }

                    if root.has-tray : Button {
                        text: @tr("Keep running in tray");
                        primary: true;
                        clicked => { root.minimise-to-tray(); }
                    }

                    Button {
                        text: @tr("Quit");
                        clicked => { root.confirm-quit(); }
                    }
                }
            }
        }
    }

    VerticalLayout {

    if root.tool-change-notice != "" : Rectangle {
        height: 44px;
        background: Palette.alternate-background;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;

            Text {
                text: root.tool-change-notice;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                color: Palette.foreground;
            }

            if root.can-rebuild : Button {
                text: @tr("Rebuild and restart");
                primary: true;
                clicked => { root.rebuild-requested(); }
            }

            Button {
                text: @tr("Not now");
                clicked => { root.dismiss-notice(); }
            }
        }
    }

    HorizontalLayout {
        side-bar := SideBar {
            title: @tr("Luna Widgets Library");
            model: root.tools;
            current-item <=> root.current-tool-index;

            changed current-id => { root.tool-changed(self.current-id); }

            // The dock at the foot of the sidebar. Global settings for now; anything
            // else that belongs to the shell rather than to a tool goes in beside it,
            // and the row fills from the left.
            IconButton {
                icon: "⚙";
                label: @tr("Settings");
                active: root.showing-settings;
                clicked => { root.showing-settings = !root.showing-settings; }
            }
        }

        if root.showing-settings : PalettePicker {
            palettes: root.palettes;
            active-id: root.active-palette-id;
            palettes-folder: root.palettes-folder;
            palette-chosen(id) => { root.palette-chosen(id); }
        }

        if !root.showing-settings && side-bar.current-id != "" : ToolPages {
            current-tool-id: side-bar.current-id;
        }

        if !root.showing-settings && side-bar.current-id == "" : Rectangle {
            background: Palette.background;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: @tr("No tools are enabled");
                    font-size: 18px;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }

                Text {
                    text: @tr("Enable a tool to get started.");
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.7;
                }
            }
        }
    }

    }
}
