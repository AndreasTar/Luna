import { HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";
import { Chrome } from "icon_button.slint";

// One entry in the sidebar, built from an enabled tool's manifest.
//
// The list is populated at runtime from the registry rather than written out here,
// so enabling or disabling a tool changes the sidebar with no rebuild.
export struct SidebarEntry {
    id: string,
    name: string,
    category: string,
}

component SideBarItem inherits Rectangle {
    in property <int> tab-index;
    in property <bool> selected;
    in property <bool> has-focus;
    in-out property <string> text <=> label.text;

    callback clicked <=> touch.clicked;

    min-height: tabTitle.preferred-height;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-index: root.tab-index;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { self.clicked(); }

    states [
        pressed when touch.pressed : {
            state.opacity: 0.8;
        }
        hover when touch.has-hover : {
            state.opacity: 0.6;
        }
        selected when root.selected : {
            state.opacity: 1;
        }
        focused when root.has-focus : {
            state.opacity: 0.8;
        }
    ]

    state := Rectangle {
        opacity: 0;
        background: Palette.background;

        animate opacity { duration: 150ms; }
    }

    tabTitle := HorizontalBox {
        y: (parent.height - self.height) / 2;
        spacing: 0px;

        label := Text {
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
    }
}

export component SideBar inherits Rectangle {
    in property <[SidebarEntry]> model: [];
    in property <string> title <=> label.text;

    // in-out rather than out: startup restores the tool that was open last time.
    in-out property <int> current-item: 0;

    // Pages are keyed by tool id, not by index, because the model changes as tools
    // are enabled and disabled and an index would silently point at a different tool.
    // Empty when nothing is selectable, which is what the empty state keys off.
    out property <string> current-id:
        root.model.length > 0 && root.current-item >= 0 && root.current-item < root.model.length
            ? root.model[root.current-item].id
            : "";

    out property <int> current-focused: fs.has-focus ? fs.focused-tab : -1; // The currently focused tab

    width: 180px;
    forward-focus: fs;

    Rectangle {
        background: Palette.background.darker(0.2);
    }

    VerticalBox {
        padding-left: 0px;
        padding-right: 0px;

        // No `alignment: start`. The title and the tool list state that they do not
        // stretch, the spacer below the list takes everything that is left, and the dock
        // at the foot keeps the height it asks for. An alignment would have handed every
        // one of them its preferred size and pooled the slack at one end, which is not
        // the same thing: the dock has to be pinned to the bottom edge whether there are
        // two tools in the list or twenty.

        label := Text {
            vertical-stretch: 0;
            font-size: 16px;
            horizontal-alignment: center;
        }

        navigation := VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            accessible-role: tab-list;
            accessible-delegate-focus: root.current-focused >= 0 ? root.current-focused : root.current-item;
            accessible-label: root.title;
            accessible-item-count: root.model.length;

            fs := FocusScope {
                key-pressed(event) => {
                    if (event.text == "\n") {
                         root.current-item = root.current-focused;
                         return accept;
                    }
                    if (event.text == Key.UpArrow) {
                         self.focused-tab = Math.max(self.focused-tab - 1, 0);
                         return accept;
                    }
                    if (event.text == Key.DownArrow) {
                         self.focused-tab = Math.min(self.focused-tab + 1, root.model.length - 1);
                         return accept;
                    }
                    return reject;
                }

                key-released(event) => {
                    if (event.text == " ") {
                         root.current-item = root.current-focused;
                         return accept;
                    }
                    return reject;
                }

                property <int> focused-tab: 0;

                x: 0;
                width: 0; // Do not react on clicks
            }

            for item[index] in root.model : SideBarItem {
                clicked => { root.current-item = index; }

                tab-index: index;
                has-focus: index == root.current-focused;
                text: item.name;
                selected: index == root.current-item;
            }
        }

        // Everything the list and the dock do not use, so the dock sits on the bottom
        // edge rather than following the last tool in the list.
        Rectangle { vertical-stretch: 1; }

        dock := HorizontalLayout {
            // A set size, as asked: a row of buttons that neither grows nor shrinks.
            // More buttons go in beside the first one, and the row fills left to right.
            vertical-stretch: 0;
            height: Chrome.dock_height;
            padding: Chrome.chrome_padding;
            spacing: Chrome.chrome_spacing;
            alignment: start;

            @children
        }
    }
}