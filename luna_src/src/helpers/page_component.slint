import { Switch, GridBox, ListView, ScrollView, HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

import { LunaLibraryGlobalSettings } from "gallery_settings.slint";
import { Chrome, IconButton } from "icon_button.slint";
import { Theme } from "theme.slint";

export component PageComponent inherits VerticalBox {
    in property <string> title: @tr("default title");
    in property <string> description: @tr("default description");
    in property <bool> is-page-enabled: true;
    in property <bool> show-enable-page-widgets-switch: false; // TODO adapt these switches
    in property <bool> show-enable-read-only: false;

    // The cog at the left of the bar. The panel it belongs to does not exist yet, so the
    // state is tracked here and a placeholder strip stands in for it. A tool that grows
    // real settings reads `showing-tool-settings` and draws its own.
    callback settings-clicked();
    in-out property <bool> showing-tool-settings: false;

    accessible-role: tab-panel;
    accessible-label: root.title;

    // The bar across the top of every tool page.
    //
    // Two children of one grid cell, so the layout hands both the full width of the bar.
    // The name is centred on the bar itself that way, rather than on whatever space the
    // controls happen to leave over, which would put it off centre by half the
    // difference between the two sides. A Text takes no input, so the controls beneath
    // it still take their clicks.
    top-bar := GridLayout {

        // Full width, natural height, whatever the window does. A stretch factor of 0
        // only holds while something else in the layout is willing to grow, which is
        // what the wrapper around the page content below is for.
        vertical-stretch: 0;

        HorizontalLayout {
            row: 0;
            col: 0;

            padding: Chrome.chrome_padding;
            spacing: Chrome.chrome_spacing;

            // The "send to tool" dropdown goes here, on the left.

            // Spacer
            Rectangle { }

            if show-enable-page-widgets-switch: Switch {
                horizontal-stretch: 0;
                text: @tr("Widgets enabled");
                checked <=> LunaLibraryGlobalSettings.widgets-enabled;
                enabled: true;
            }

            if show-enable-read-only: Switch {
                horizontal-stretch: 0;
                text: @tr("Widgets read-only");
                checked <=> LunaLibraryGlobalSettings.widgets-read-only;
                enabled: true;
            }

            // Light and dark are two palettes, not two modes of one, so this asks the
            // shell to swap which palette is active rather than recolouring the current
            // one. Until that pairing exists in settings it still flips the widget
            // styling, which is all the switch it replaced ever did.
            //
            // `Palette.color-scheme` stays the single record of which scheme is showing.
            // Keeping a second copy alongside it would only be one more thing that can
            // disagree with what is on screen.
            IconButton {
                icon: Palette.color-scheme == ColorScheme.dark ? "☀" : "☽";
                label: Palette.color-scheme == ColorScheme.dark
                     ? @tr("Switch to the light palette")
                     : @tr("Switch to the dark palette");
                clicked => {
                    Palette.color-scheme = Palette.color-scheme == ColorScheme.dark
                                         ? ColorScheme.light
                                         : ColorScheme.dark;
                    Theme.scheme_toggled(Palette.color-scheme == ColorScheme.dark);
                }
            }

            IconButton {
                icon: "⚙";
                label: @tr("Tool settings");
                active: root.showing-tool-settings;
                clicked => {
                    root.showing-tool-settings = !root.showing-tool-settings;
                    root.settings-clicked();
                }
            }
        }

        Text {
            row: 0;
            col: 0;

            // Zero, so a long name cannot widen the bar and through it the window. It
            // can still run under the controls either side of it at narrow widths, which
            // is the price of centring on the bar rather than between them.
            min-width: 0px;

            font-size: 20px;
            text <=> root.title;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Stands in for the settings panel until there is one, so the cog does something
    // visible rather than nothing. Replace the whole strip when a tool has real settings
    // to show.
    if root.showing-tool-settings : Rectangle {
        vertical-stretch: 0;
        height: Chrome.dock_height;
        border-radius: Chrome.corner_radius;
        background: Theme.background_secondary;

        Text {
            text: @tr("This tool has no settings yet.");
            font-size: 13px;
            color: Theme.text_secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The page content takes every pixel the bar above does not.
    //
    // The explicit stretch is the part that matters. A stretch factor of 0 only means
    // "do not grow" while something else in the layout is willing to: when every item
    // in a layout reports 0, Slint falls back to splitting the surplus equally, and the
    // bar grows with the window after all. A tool page whose content happened to report
    // 0 (a column of fixed-height widgets, say) triggered exactly that. Stating 1 here
    // guarantees the total is never 0, whatever the tool puts inside.
    VerticalLayout {
        vertical-stretch: 1;

        @children
    }
}
