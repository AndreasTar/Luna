}

export component ToolPage inherits PageComponent {
    title: @tr("Calendar Widget");
    description: @tr("A calendar widget with monthly, daily and yearly views.");
    show-enable-read-only: false;
    show-enable-page-widgets-switch: false;

    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-top: 10px;

    // What the page opens at. The minimum is not stated anywhere; it falls out of the
    // three columns and lands around 880 by 620.
    preferred_width: 1200px;
    preferred_height: 760px;


    // Three columns: month over year on the left, the day in the middle, upcoming over
    // notes on the right.
    //
    // Nothing here declares a min-width or min-height for the layouts themselves. Slint
    // already works those out from the children and propagates them up to the window,
    // so writing the arithmetic by hand is both redundant and easy to get backwards:
    // in a horizontal layout the min height is the *tallest* child, not the sum, and in
    // a vertical layout the min width is the *widest* child, not the sum.
    //
    // Nothing sets a percentage width either. An explicit width on a child overrides
    // the layout's own distribution, so it fights the child's min-width instead of
    // respecting it, and the percentages did not leave room for the spacing between
    // columns.
    //
    // Instead each column states its own minimum and maximum, and the spacers on the
    // outside take whatever is left over. That gives the window a natural minimum size
    // with no maximum, and turns surplus width into even padding rather than stretching
    // the columns past the point where they look right.
    outer_layout := HorizontalLayout {

        spacing: 5px;
        padding-bottom: 10px;

        // The spacers stretch far more slowly than the columns do. With everything on
        // the default factor of 1 the surplus was split five ways, so padding appeared
        // at the edges while the columns were still nowhere near the width they are
        // allowed to reach. Weighted like this the columns fill out to their maximum
        // first and only what is left over past that becomes padding.
        Rectangle { 
            horizontal-stretch: 1; 
            max-width: 15px;
        }

        month_year_layout := VerticalLayout {

            horizontal-stretch: 30;
            // No min-width. The year view below states what a legible day cell costs,
            // and twelve months of them decide this column's minimum far more reliably
            // than a number typed here, which was quietly narrower than its contents.
            max-width: 520px;
            padding-bottom: 5px;
            spacing: 5px;

            month_view := MonthlyView {

                // The month grows first but stops at 260, and the year below takes the
                // rest of the column. Both need a factor above 0: an unmarked pair would
                // be split down the middle regardless of how much each one can use.
                vertical-stretch: 1;

                current_date_string: "Test Date";
                day_cell_dims: 20px;

                min-height: 180px;
                max-height: 260px;
            }

            year_view := YearlyView {

                vertical-stretch: 3;
                current_year: 2026;

                // No min-height either, for the same reason: three rows of months know
                // their own floor, and the column takes the rest of the height.
            }
        }

        day_view := DailyView {

            horizontal-stretch: 40;
            min-width: 260px;
            max-width: 640px;

            current_date: "Test date";

            hour_cell_width: 400px;
        }

        upcoming_notes_layout := VerticalLayout {

            horizontal-stretch: 30;
            min-width: 180px;
            max-width: 400px;
            padding-bottom: 5px;
            spacing: 5px;

            upcoming_view := UpcomingView {
                vertical-stretch: 1;
                min-height: 120px;
                max-height: 300px;
            }

            notes_view := NotesView {
                vertical-stretch: 2;
                min-height: 140px;
                max-height: 600px;
            }
        }

        Rectangle { 
            horizontal-stretch: 1; 
            max-width: 15px;
        }
    }

}
