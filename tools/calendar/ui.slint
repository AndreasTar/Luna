
import { PageComponent } from "../../luna_src/src/helpers/page_component.slint";
import { TextEdit, ScrollView, LineEdit, Button, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "../../luna_src/src/helpers/theme.slint";
import { IconButton, Chrome } from "../../luna_src/src/helpers/icon_button.slint";
import {
    Global_Calendar_Callback,
    Global_Calendar_Data,
    DayCell,
    MonthCell,
    HourCell,
    EventCell,
    EventDraft,
    UpcomingEventsCell,
} from "../../luna_src/src/helpers/global_callbacks.slint";

//    Simple_AMPM, //  8:00 pm |  8:00 am
//    Full_AMPM,   // 08:00 pm | 08:00 am
//    Army_AMPM,   // 20:00 pm | 08:00 am
//    Simple,      // 20:00    |  8:00
//    Army,        // 20:00    | 08:00
enum HourStampType {
    Simple_AMPM,
    Full_AMPM,
    Army_AMPM,
    Simple,
    Army,
}

// Sizes, spacings and the colours derived from the palette, in one place so the whole
// page can be tuned without hunting.
global CalendarMetrics {
    // The floor for one day cell in the year view. Twelve months of these decide the
    // page's minimum width, so it is the dial that trades legibility against how small
    // the window can be made.
    out property <length> year_day: 11px;
    out property <length> year_day_font: year_day * 0.85;

    out property <length> month_day: 20px;

    // The 5 to 15 range the whole calendar keeps to.
    out property <length> pad: 5px;
    out property <length> pad_wide: 10px;
    out property <length> gap: 5px;

    out property <length> radius: 6px;

    // How tall one hour is in the day view before any surplus is handed out.
    out property <length> hour_row: 22px;
    out property <length> hour_gap: 2px;
    // The strip down the left of the day view that holds the times, which event blocks
    // start to the right of.
    out property <length> hour_gutter: 62px;
    // However short an entry is, it stays this tall, or a fifteen minute one would be a
    // line too thin to read or click.
    out property <length> event_min_height: 16px;

    // The three columns, as fractions of the page. The minimum widths below are in the
    // same proportion, so the split holds at every window size rather than only once
    // there is surplus to hand out: stretch factors divide the space above the minimums,
    // and minimums in a different ratio would skew the result at the narrow end.
    out property <length> col_side_min: 285px;
    out property <length> col_day_min: 380px;

    // A selected day is tinted rather than filled. A block of solid highlight reads as
    // the loudest thing on a page that also has today, entry markers and the current
    // hour to point out, so the selection is the faintest of them and the outline is
    // what makes it unambiguous.
    out property <brush> selection_fill: Theme.highlight.transparentize(0.78);
    out property <brush> selection_edge: Theme.highlight.transparentize(0.35);

    // The hairlines between sections. Derived from the text colour rather than from the
    // border role, because a border is free to be near-invisible against its background
    // while a separator has to be seen; softened so it divides without drawing the eye.
    out property <brush> divider: Theme.text_secondary.transparentize(0.65);
}

// A hairline between two sections.
component VDivider inherits Rectangle {
    horizontal-stretch: 0;
    width: 1px;
    background: CalendarMetrics.divider;
}

component HDivider inherits Rectangle {
    vertical-stretch: 0;
    height: 1px;
    background: CalendarMetrics.divider;
}

// Cells that will be present in the daily view
component HourCellButton inherits Rectangle {
    in property <HourCell> hour_data;
    in property <HourStampType> hour_type: HourStampType.Army;

    callback hour_clicked(int);
    callback hour_double_clicked(int);

    pure function convert_time_to_signature(hour: int) -> string {
        return    root.hour_type == HourStampType.Simple_AMPM ? hour < 12 ?
                      hour + ":00 am" : hour + ":00 pm"
                : root.hour_type == HourStampType.Full_AMPM   ? hour < 10 ?
                      "0" + hour + ":00 am" : hour < 12 ? hour + ":00 am" :
                      hour < 22 ? "0" + hour + ":00 pm" : hour + ":00 pm"
                : root.hour_type == HourStampType.Army_AMPM   ? hour < 10 ?
                      "0" + hour + ":00 am" : hour < 12 ? hour + ":00 am" : hour + ":00 pm"
                : root.hour_type == HourStampType.Simple      ? hour < 12 ?
                      hour + ":00" : hour + ":00"
                : root.hour_type == HourStampType.Army        ? hour < 10 ?
                      "0"+ hour + ":00" : hour + ":00"
                : "UNDEFINED";
    }

    background: root.hour_data.is_selected                ? CalendarMetrics.selection_fill
              : ta.has-hover                              ? Theme.background_tertiary
              : Math.mod(root.hour_data.hour_num, 2) == 0 ? Theme.background_secondary
              : Theme.background;

    ta := TouchArea {
        clicked => { root.hour_clicked(root.hour_data.hour_num); }
        double-clicked => { root.hour_double_clicked(root.hour_data.hour_num); }
    }

    Text {
        width: 100%;
        height: 100%;
        text: convert_time_to_signature(root.hour_data.hour-num);
        font-size: 13px;
        color: root.hour_data.is_current ? Theme.highlight : Theme.text_secondary;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
}

// Cells that will be present in the Monthly and Yearly view
component DayCellButton inherits Rectangle {
    in property <DayCell> day_data;
    in property <bool> visible_days_num: true;
    // The same cell is drawn at two very different sizes: a readable date in the
    // monthly view, a speck in the yearly one. The caller sets the type size to match
    // the cell it asked for.
    in property <length> day_font_size: 14px;

    callback day_clicked();
    callback day_double_clicked();

    border-radius: CalendarMetrics.radius * 2;

    // Today is outlined, the selection is tinted and outlined more strongly. Two
    // different marks rather than two shades of one, so a selected day that is also
    // today still reads as both.
    border-width: root.day_data.is_selected || root.day_data.is_today ? 1px : 0px;
    border-color: root.day_data.is_selected ? CalendarMetrics.selection_edge
                                            : Theme.border_secondary;

    background: root.day_data.is_selected ? CalendarMetrics.selection_fill
              : ta.has_hover              ? Theme.background_tertiary
              : transparent;

    ta := TouchArea {
        clicked => { root.day_clicked(); }
        double-clicked => { root.day_double_clicked(); }
    }

    if visible_days_num : Text {
        // Fills the cell, so the alignments below have the cell to align within rather
        // than the width of the digits themselves.
        width: 100%;
        height: 100%;

        // States its own minimum as zero so the cell can shrink smaller than the number it holds. 
        // A Text otherwise reports the size of its glyphs as a hard minimum, and that propagates all 
        // the way out to the window: with twelve months of them on screen it was the year view, not the day view, 
        // deciding how small the window could be. The number is clipped rather than resized when the cell gets tight.
        min-width: 0px;
        min-height: 0px;

        text: root.day_data.day_num;
        font-size: root.day_font_size;
        font-weight: FontWeight.semi-bold;
        color: root.day_data.is_today ? Theme.highlight : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.day_data.in_month ? 1.0 : 0.45;
    }

    // Something is on this day. A dot rather than a count, because at the year view's
    // size a count would be unreadable and at the month view's it would still be noise.
    if root.day_data.has_events : Rectangle {
        width: 4px;
        height: 4px;
        border-radius: 2px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 2px;
        background: Theme.highlight;
    }
}

// Cells that will be present in the Yearly view
component MonthCellButton inherits Rectangle {

    in property <MonthCell> month_data;
    in property <string> month_name;
    callback month_clicked();

    border-radius: CalendarMetrics.radius * 2;
    border-color: root.month_data.is_selected ? CalendarMetrics.selection_edge : Theme.border;
    border-width: 1px;

    background: root.month_data.is_selected                 ? CalendarMetrics.selection_fill
              : ta.has_hover                                ? Theme.background_secondary
              : Math.mod(root.month_data.month-num, 2) == 0 ? Theme.background_secondary
              : transparent;

    ta := TouchArea { clicked => { root.month_clicked(); } }

    VerticalLayout {

        // Twelve of these sit side by side, so every pixel of padding here is twelve
        // pixels of minimum width on the window. Kept to the low end of the 5 to 15
        // range the rest of the calendar uses.
        padding: CalendarMetrics.pad;
        spacing: 2px;

        Text {
            vertical-stretch: 0;
            text: root.month_name;
            font-size: 12px;
            color: root.month_data.is_current ? Theme.highlight
                 : root.month_data.in_year    ? Theme.text_secondary
                 : Theme.text_tertiary;
            horizontal-alignment: center;
            vertical-alignment: top;
        }

        @children
    }
}

// A row of navigation: back, a label, forward.
component StepHeader inherits HorizontalLayout {
    in property <string> label;

    callback stepped(int);

    vertical-stretch: 0;
    spacing: CalendarMetrics.gap;

    Button {
        horizontal-stretch: 0;
        text: "<";
        clicked => { root.stepped(-1); }
    }

    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        text: root.label;
        font-weight: FontWeight.semi-bold;
        font-size: 15px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Button {
        horizontal-stretch: 0;
        text: ">";
        clicked => { root.stepped(1); }
    }
}

component DailyView inherits Rectangle {

    outer_hour := VerticalLayout {
        padding: CalendarMetrics.pad_wide;
        spacing: CalendarMetrics.gap;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: CalendarMetrics.gap;
            max-height: 50px;

            date := Text {
                horizontal-stretch: 1;
                min-width: 0px;
                color: Theme.text;
                text: Global_Calendar_Data.day_label;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }

            // The way back after wandering off through the months. Without it the only
            // route home is counting steps in the other direction.
            Button {
                horizontal-stretch: 0;
                text: @tr("Today");
                clicked => { Global_Calendar_Callback.today_selected(); }
            }
        }

        // The hours and the entries drawn over them, in one grid cell so both get the
        // same geometry. An entry is placed by arithmetic on that geometry rather than
        // by sitting in an hour's cell, because an entry spanning four hours belongs to
        // no single cell, and one starting at 09:30 belongs inside one.
        hours_stack := GridLayout {
            vertical-stretch: 1;

            hours_layout := VerticalLayout {
                row: 0;
                col: 0;
                spacing: CalendarMetrics.hour_gap;

                for h in Global_Calendar_Data.day_hours : HourCellButton {
                    hour_data: h;
                    min-height: CalendarMetrics.hour_row;

                    hour_clicked(hour) => { Global_Calendar_Callback.hour_selected(hour); }
                    hour_double_clicked(hour) => {
                        Global_Calendar_Callback.editor_new_requested(-1, hour);
                    }
                }
            }

            Rectangle {
                row: 0;
                col: 0;

                for ev in Global_Calendar_Data.day_events : Rectangle {
                    // One hour's worth of height, including the gap below it. 
                    // Fractions of it are what put a half past start half way down a row.
                    property <length> slot:
                        (parent.height - 23 * CalendarMetrics.hour_gap) / 24
                        + CalendarMetrics.hour_gap;

                    x: CalendarMetrics.hour_gutter;
                    width: parent.width - CalendarMetrics.hour_gutter - CalendarMetrics.pad;
                    y: ev.all_day ? 0px : ev.start_hour * self.slot;
                    height: ev.all_day
                          ? parent.height
                          : max(CalendarMetrics.event_min_height,
                                (ev.end_hour - ev.start_hour) * self.slot - CalendarMetrics.hour_gap);

                    background: Theme.primary;
                    border-radius: CalendarMetrics.radius;
                    border-width: ev.is_selected ? 2px : 1px;
                    border-color: ev.is_selected ? Theme.highlight : Theme.border_secondary;
                    opacity: ev.all_day ? 0.35 : 0.9;

                    event_touch := TouchArea {
                        clicked => { Global_Calendar_Callback.event_selected(ev.id); }
                        double-clicked => { Global_Calendar_Callback.editor_edit_requested(ev.id); }
                    }

                    HorizontalLayout {
                        padding: CalendarMetrics.pad;
                        spacing: CalendarMetrics.gap;

                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text: (ev.repeats ? "* " : "") + ev.title;
                            font-size: 12px;
                            color: Theme.text;
                            vertical-alignment: top;
                            overflow: elide;
                        }

                        // Its own control rather than a click anywhere on the block, so
                        // an entry cannot be deleted by a stray click on the thing you
                        // were trying to read.
                        Rectangle {
                            horizontal-stretch: 0;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: remove_touch.has-hover ? Theme.error : transparent;

                            remove_touch := TouchArea {
                                clicked => { Global_Calendar_Callback.event_removed(ev.id); }
                            }

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "x";
                                font-size: 12px;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

component MonthlyView inherits Rectangle {

    in property <length> day_cell_dims: CalendarMetrics.month_day;

    outer_month := VerticalLayout {
        padding: CalendarMetrics.pad;
        padding-bottom: CalendarMetrics.pad_wide;
        spacing: CalendarMetrics.gap;

        StepHeader {
            label: Global_Calendar_Data.month_label;
            stepped(by) => { Global_Calendar_Callback.month_step(by); }
        }

        days_grid := GridLayout {

            vertical-stretch: 1;
            preferred-width: day_cell_dims * 7 + 5px;
            preferred-height: day_cell_dims * 6 + 5px;

            for days_list[d] in ["M", "T", "W", "T", "F", "S", "S"] : Text {
                col: d;
                row: 0;

                font-weight: FontWeight.semi-bold;
                font-size: 15px;
                vertical-alignment: center;
                horizontal-alignment: center;
                preferred-width: day_cell_dims;
                text: days_list;
                color: Theme.text_secondary;
            }

            // Exactly 42 cells, already carrying the weekday offset and the days either
            // side. Nothing here works out what day anything is.
            for cell[i] in Global_Calendar_Data.month_grid : DayCellButton {
                col: Math.mod(i, 7);
                row: (i / 7) + 1;

                // A grid row takes the smallest stretch among its cells, so marking the
                // day cells is what keeps the header row above at its own height
                // instead of growing along with the dates.
                vertical-stretch: 1;

                preferred-width: day_cell_dims;
                preferred-height: day_cell_dims;

                day_data: cell;
                day_clicked => { Global_Calendar_Callback.day_selected(i); }
                day_double_clicked => { Global_Calendar_Callback.editor_new_requested(i, -1); }
            }
        }
    }
}

component YearlyView inherits Rectangle {

    in property <length> day_cell_dims: CalendarMetrics.year_day;
    in property <length> day_font_size: CalendarMetrics.year_day_font;
    in property <bool> show_day_numbers: true;

    property <[string]> month_names: [
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];

    outer_layout := VerticalLayout {

        // No `alignment`. An alignment other than the default stretch hands every child
        // its preferred size and parks the leftover space at one end, which is why the
        // grid below used to sit in the top corner with the rest of the panel empty
        // underneath it.
        padding: CalendarMetrics.pad;
        spacing: CalendarMetrics.gap;

        StepHeader {
            label: Global_Calendar_Data.year_label;
            stepped(by) => { Global_Calendar_Callback.year_step(by); }
        }

        months_grid := GridLayout {

            // Takes the panel's height rather than sharing it with the year label.
            vertical-stretch: 1;
            spacing: CalendarMetrics.gap;
            padding: CalendarMetrics.pad;

            // Three across, four down. Narrower than four across, which is what lets the
            // whole left column hold to its 30 percent share of the page rather than
            // being the thing that decides how wide Luna has to be.
            for month[m] in Global_Calendar_Data.year_months : MonthCellButton {

                col: Math.mod(m, 3);
                row: m / 3 ;

                // Nothing sized here. The day cells state a minimum, the grid around
                // them adds it up, and the month cell inherits the total plus its own
                // label and padding.
                month_data: month;
                month_name: root.month_names[m];

                month_clicked => { Global_Calendar_Callback.year_month_selected(m); }

                days_grid := GridLayout {

                    // And the days take the month cell's height rather than sharing it
                    // with the month number above them.
                    vertical-stretch: 1;

                    // The same 42 cell grid as the month view, so the weekday columns
                    // line up across all twelve. Month m's cell i lives at m * 42 + i in
                    // one flat array.
                    for d in 42 : DayCellButton {
                        col: Math.mod(d, 7);
                        row: d / 7 ;

                        day_data: Global_Calendar_Data.year_days[m * 42 + d];
                        visible_days_num: root.show_day_numbers
                                       && Global_Calendar_Data.year_days[m * 42 + d].in_month;
                        day_font_size: root.day_font_size;

                        // Minimum rather than preferred. A preferred size is what an
                        // element settles at when the layout has space to spare, so the
                        // cells sat at their ideal and left the panel half empty; as a
                        // minimum it is the floor they shrink to and the grid spends the
                        // surplus on them instead.
                        min-height: day_cell_dims;
                        min-width: day_cell_dims;

                        day_clicked => { Global_Calendar_Callback.year_day_selected(m * 42 + d); }
                        day_double_clicked => {
                            Global_Calendar_Callback.year_day_selected(m * 42 + d);
                            Global_Calendar_Callback.editor_new_requested(-1, -1);
                        }
                    }
                }
            }
        }
    }
}

component UpcomingEventButton inherits Rectangle {

    in property <UpcomingEventsCell> event_data;
    in property <bool> selected;

    callback upcoming_event_clicked();
    callback upcoming_event_double_clicked();

    border-radius: CalendarMetrics.radius;
    border-width: root.selected ? 1px : 0px;
    border-color: CalendarMetrics.selection_edge;
    background: root.selected      ? CalendarMetrics.selection_fill
              : ta.has_hover       ? Theme.background_tertiary
              : transparent;
    min-height: 30px;

    ta := TouchArea {
        clicked => { root.upcoming_event_clicked(); }
        double-clicked => { root.upcoming_event_double_clicked(); }
    }

    HorizontalLayout {
        padding: CalendarMetrics.pad;
        spacing: CalendarMetrics.gap;

        Text {
            horizontal-stretch: 0;
            min-width: 52px;
            text: root.event_data.event_date;
            font-size: 12px;
            color: root.event_data.is_today ? Theme.highlight : Theme.text_secondary;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.event_data.event_title;
            font-size: 13px;
            font-weight: FontWeight.semi-bold;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component UpcomingView inherits Rectangle {

    outer_layout := VerticalLayout {
        padding: CalendarMetrics.pad;
        spacing: CalendarMetrics.gap;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: CalendarMetrics.gap;

            title_text := Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: @tr("UPCOMING");
                font-size: 12px;
                color: Theme.text_secondary;
                vertical-alignment: center;
            }

            // New entries start here. The editor opens prefilled with the day that is
            // selected, so the common case of "something on this day" needs no typing
            // of a date at all.
            IconButton {
                icon: "+";
                label: @tr("New entry");
                clicked => { Global_Calendar_Callback.editor_new_requested(-1, -1); }
            }

            // Only present with something to act on, rather than sitting there greyed
            // out: there is nothing to explain about an edit button when no entry is
            // picked, and the row is short of space as it is.
            if Global_Calendar_Data.selected_event_id != 0 : IconButton {
                icon: "✎";
                label: @tr("Edit entry");
                clicked => {
                    Global_Calendar_Callback.editor_edit_requested(
                        Global_Calendar_Data.selected_event_id);
                }
            }
        }

        events_scroll_area := ScrollView {
            // The list takes the panel, the heading keeps its line.
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                spacing: 2px;

                for event[e] in Global_Calendar_Data.upcoming : UpcomingEventButton {
                    event_data: event;
                    selected: event.event_id == Global_Calendar_Data.selected_event_id;

                    upcoming_event_clicked => {
                        Global_Calendar_Callback.upcoming_selected(e);
                    }
                    upcoming_event_double_clicked => {
                        Global_Calendar_Callback.editor_edit_requested(event.event_id);
                    }
                }
            }
        }
    }
}

component NotesView inherits Rectangle {

    outer_layout := VerticalLayout {

        padding: CalendarMetrics.pad;
        spacing: CalendarMetrics.gap;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: CalendarMetrics.gap;

            date_text := Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: @tr("Notes");
                font-size: 12px;
                color: Theme.text_secondary;
                vertical-alignment: center;
                overflow: elide;
            }

            Button {
                horizontal-stretch: 0;
                text: Global_Calendar_Data.note_unsaved ? @tr("Save *") : @tr("Save");
                enabled: Global_Calendar_Data.note_unsaved;
                clicked => { Global_Calendar_Callback.note_saved(); }
            }
        }

        notes_field := TextEdit {
            // Same again: the writing area takes the panel, the date keeps its line.
            vertical-stretch: 1;
            font-size: 12px;
            text: Global_Calendar_Data.note_body;
            edited => { Global_Calendar_Callback.note_edited(self.text); }
        }
    }
}

// One labelled field in the editor.
component FieldRow inherits HorizontalLayout {
    in property <string> label;

    vertical-stretch: 0;
    spacing: CalendarMetrics.gap;

    Text {
        horizontal-stretch: 0;
        width: 110px;
        text: root.label;
        font-size: 13px;
        color: Theme.text_secondary;
        vertical-alignment: center;
    }

    @children
}

// The entry editor.
//
// Created fresh each time it opens, which is what lets every field simply bind its
// initial value to the draft: the binding is evaluated once on creation and then
// replaced as the user types, and the next open builds a new instance from a new draft.
// A long-lived dialog would need each field cleared and refilled by hand, and one missed
// field would show the previous entry's value.
component EventEditor inherits Rectangle {

    // Dims the page behind and swallows its clicks, so the calendar cannot be operated
    // while the dialog is up.
    background: Theme.background.transparentize(0.2);

    TouchArea { }

    Rectangle {
        width: min(parent.width - 40px, 460px);
        height: min(parent.height - 40px, card_layout.preferred-height);

        background: Theme.background_secondary;
        border-radius: CalendarMetrics.radius * 2;
        border-width: 1px;
        border-color: Theme.border_secondary;

        card_layout := VerticalLayout {
            padding: CalendarMetrics.pad_wide * 1.5;
            spacing: CalendarMetrics.pad_wide;

            Text {
                vertical-stretch: 0;
                text: Global_Calendar_Data.editor_is_edit ? @tr("Edit entry") : @tr("New entry");
                font-size: 17px;
                font-weight: FontWeight.semi-bold;
                color: Theme.text;
            }

            FieldRow {
                label: @tr("Title");

                title_field := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: @tr("What is it");
                    text: Global_Calendar_Data.draft.title;
                }
            }

            FieldRow {
                label: @tr("Date");

                day_field := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "YYYY-MM-DD";
                    text: Global_Calendar_Data.draft.day;
                }
            }

            FieldRow {
                label: @tr("From / to");

                start_field := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "HH:MM";
                    enabled: !all_day_box.checked;
                    text: Global_Calendar_Data.draft.start_time;
                }

                end_field := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "HH:MM";
                    enabled: !all_day_box.checked;
                    text: Global_Calendar_Data.draft.end_time;
                }
            }

            FieldRow {
                label: @tr("All day");

                all_day_box := CheckBox {
                    horizontal-stretch: 1;
                    text: @tr("Runs the whole day");
                    checked: Global_Calendar_Data.draft.all_day;
                }
            }

            FieldRow {
                label: @tr("Repeats");

                repeat_box := ComboBox {
                    horizontal-stretch: 1;
                    // In the order the draft's repeat_kind counts them.
                    model: [@tr("Never"), @tr("Daily"), @tr("Weekly"), @tr("Monthly"), @tr("Yearly")];
                    current-index: Global_Calendar_Data.draft.repeat_kind;
                }
            }

            FieldRow {
                label: @tr("Remind before");

                remind_days_field := LineEdit {
                    horizontal-stretch: 1;
                    input-type: decimal;
                    placeholder-text: @tr("days");
                    text: Global_Calendar_Data.draft.remind_days == 0
                        ? "" : Global_Calendar_Data.draft.remind_days;
                }

                remind_hours_field := LineEdit {
                    horizontal-stretch: 1;
                    input-type: decimal;
                    placeholder-text: @tr("hours");
                    text: Global_Calendar_Data.draft.remind_hours == 0
                        ? "" : Global_Calendar_Data.draft.remind_hours;
                }
            }

            FieldRow {
                label: @tr("Description");

                description_field := TextEdit {
                    horizontal-stretch: 1;
                    min-height: 70px;
                    font-size: 12px;
                    text: Global_Calendar_Data.draft.description;
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: CalendarMetrics.gap;

                if Global_Calendar_Data.editor_is_edit : Button {
                    horizontal-stretch: 0;
                    text: @tr("Delete");
                    clicked => {
                        Global_Calendar_Callback.event_removed(Global_Calendar_Data.draft.id);
                        Global_Calendar_Callback.editor_cancelled();
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    horizontal-stretch: 0;
                    text: @tr("Cancel");
                    clicked => { Global_Calendar_Callback.editor_cancelled(); }
                }

                Button {
                    horizontal-stretch: 0;
                    primary: true;
                    text: @tr("Save");
                    enabled: title_field.text != "";
                    clicked => {
                        Global_Calendar_Callback.editor_submitted({
                            id: Global_Calendar_Data.draft.id,
                            title: title_field.text,
                            day: day_field.text,
                            start_time: start_field.text,
                            end_time: end_field.text,
                            all_day: all_day_box.checked,
                            repeat_kind: repeat_box.current-index,
                            remind_days: remind_days_field.text == ""
                                       ? 0 : remind_days_field.text.to-float(),
                            remind_hours: remind_hours_field.text == ""
                                        ? 0 : remind_hours_field.text.to-float(),
                            description: description_field.text,
                        });
                    }
                }
            }
        }
    }
}

export component ToolPage inherits PageComponent {
    title: @tr("Calendar Widget");
    description: @tr("A calendar widget with monthly, daily and yearly views.");
    show-enable-read-only: false;
    show-enable-page-widgets-switch: false;

    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-top: 10px;

    // What the page opens at. The minimum is not stated anywhere; it falls out of the
    // three columns.
    preferred_width: 1200px;
    preferred_height: 760px;

    // A plain Rectangle rather than the layout directly, so the editor has something to
    // be drawn over. Children of a non-layout parent stack, and a layout fills its
    // parent, so the calendar and the dialog both get the whole page.
    Rectangle {

        // Three columns at 30, 40 and 30 percent: month over year on the left, the day
        // in the middle, upcoming over notes on the right.
        //
        // The stretch factors and the minimum widths are in the same proportion on
        // purpose. Stretch divides only the space above the minimums, so minimums in a
        // different ratio would skew the split at the narrow end and only settle towards
        // 30/40/30 once the window was large. Matching them holds the split at every size.
        outer_layout := HorizontalLayout {

            spacing: CalendarMetrics.gap;
            padding-bottom: CalendarMetrics.pad_wide;

            month_year_layout := VerticalLayout {

                horizontal-stretch: 30;
                min-width: CalendarMetrics.col_side_min;
                padding-bottom: CalendarMetrics.pad;
                spacing: CalendarMetrics.gap;

                month_view := MonthlyView {
                    // The month grows first but stops at 300, and the year below takes
                    // the rest of the column. Both need a factor above 0: an unmarked
                    // pair would be split down the middle regardless of how much each
                    // one can use.
                    vertical-stretch: 1;
                    min-height: 200px;
                    max-height: 300px;
                }

                HDivider { }

                year_view := YearlyView {
                    vertical-stretch: 3;
                }
            }

            VDivider { }

            day_view := DailyView {
                horizontal-stretch: 40;
                min-width: CalendarMetrics.col_day_min;
            }

            VDivider { }

            upcoming_notes_layout := VerticalLayout {

                horizontal-stretch: 30;
                min-width: CalendarMetrics.col_side_min;
                padding-bottom: CalendarMetrics.pad;
                spacing: CalendarMetrics.gap;

                upcoming_view := UpcomingView {
                    vertical-stretch: 1;
                    min-height: 120px;
                    max-height: 300px;
                }

                HDivider { }

                notes_view := NotesView {
                    vertical-stretch: 3;
                    min-height: 140px;
                }
            }
        }

        if Global_Calendar_Data.editor_open : EventEditor { }
    }
}
