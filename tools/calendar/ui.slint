
import { PageComponent } from "../../luna_src/src/helpers/page_component.slint";
import { TextEdit, ScrollView } from "std-widgets.slint";
import { Global_Calendar_Callback } from "../../luna_src/src/helpers/global_callbacks.slint";
//import { GlobalConversionCallback } from "..\..\helpers\global_callbacks.slint";

//    Simple_AMPM, //  8:00 pm |  8:00 am
//    Full_AMPM,   // 08:00 pm | 08:00 am
//    Army_AMPM,   // 20:00 pm | 08:00 am
//    Simple,     // 20:00     |  8:00
//    Army,       // 20:00     | 08:00
enum HourStampType {
    Simple_AMPM,
    Full_AMPM,
    Army_AMPM,
    Simple,
    Army,
}

struct HourCell {
    hour_num: int, // 0 - 24
    hour_type: HourStampType,
    time_signature: string, // 8:00am / 20:00 / etc
    is_selected: bool,
    is_current: bool,
}

struct DayCell {
    day_num: int, // 1-31 unless its 30 day or february etc
    in_month: bool,
    is_today: bool,
    is_selected: bool,
}

struct MonthCell {
    month_num: int, // 1-12
    in_year: bool,
    is_current: bool,
    is_selected: bool,
}

struct EventCell {
    // idk what it should store yet, and if it needs to be on the slint side at all
    start_hour: int, // 0000 - 2459, integer
    end_hour: int,   // 0000 - 2459, integer
    next_day: bool, // for between-days events, true if end_hour is in the next day
    title: string,
}

// Cells that will be present in the daily view
component HourCellButton inherits Rectangle {
    in property <HourCell> hour_data;

    callback hour_clicked(int);

    pure function convert_time_to_signature(hour: int) -> string {
        return    root.hour_data.hour_type == HourStampType.Simple_AMPM ? hour < 12 ? 
                      hour + ":00 am" : hour + ":00 pm" 
                : root.hour_data.hour_type == HourStampType.Full_AMPM   ? hour < 10 ? 
                      "0" + hour + ":00 am" : hour < 12 ? hour + ":00 am" :
                      hour < 22 ? "0" + hour + ":00 pm" : hour + ":00 pm"
                : root.hour_data.hour_type == HourStampType.Army_AMPM   ? hour < 10 ?
                      "0" + hour + ":00 am" : hour < 12 ? hour + ":00 am" : hour + ":00 pm"  
                : root.hour_data.hour_type == HourStampType.Simple      ? hour < 12 ?
                      hour + ":00" : hour + ":00"  
                : root.hour_data.hour_type == HourStampType.Army        ? hour < 10 ? 
                      "0"+ hour + ":00" : hour + ":00"  
                : "UNDEFINED";
    }

    // TODO add more cases for is_today & has_hover etc
    // colors are for testing
    background: root.hour_data.is_selected                ? white
              : ta.has-hover                              ? #2266cc
              : Math.mod(root.hour_data.hour_num, 2) == 0 ? #2b2a2c 
              : #1f1f1f ; 

    ta := TouchArea { clicked => { root.hour_clicked(root.hour_data.hour_num); } }

    // TODO add more cases for is_today & has_hover etc
    Text {
        width: 100%;
        height: 100%;
        text: convert_time_to_signature(root.hour_data.hour-num);
        font-size: 13px;
        color: root.hour_data.is_selected ? white
             : root.hour_data.is_current  ? #2266cc
             : #bbbbbb;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
}

// Cells that will be present in the Monthly and Yearly view
component DayCellButton inherits Rectangle {
    in property <DayCell> day_data;
    in property <bool> visible_days_num: true;
    // The same cell is drawn at two very different sizes: a readable date in the
    // monthly view, a speck in the yearly one. The caller sets the type size to match
    // the cell it asked for.
    in property <length> day_font_size: 14px;

    callback day_clicked(int);

    border-radius: 12px;
    border-color: ghostwhite;
    border-width: 0px;

    // TODO add more cases for is_today & has_hover etc
    background: root.day_data.is_selected ? #4A90E2
              : root.day_data.is_today    ? #ddeeff
              : ta.has_hover              ? #1258a2
              : transparent;

    ta := TouchArea { clicked => { root.day_clicked(root.day_data.day_num); } }

    // TODO add more cases for is_today & has_hover etc
    if visible_days_num : Text {
        // Fills the cell, so the alignments below have the cell to align within rather
        // than the width of the digits themselves.
        width: 100%;
        height: 100%;

        // States its own minimum as zero so the cell can shrink smaller than the number
        // it holds. A Text otherwise reports the size of its glyphs as a hard minimum,
        // and that propagates all the way out to the window: with twelve months of them
        // on screen it was the year view, not the day view, deciding how small Luna
        // could be. The number is clipped rather than resized when the cell gets tight.
        min-width: 0px;
        min-height: 0px;

        text: root.day_data.day_num;
        font-size: root.day_font_size;
        font-weight: FontWeight.semi-bold;
        color: root.day_data.is_selected ? white
             : root.day_data.is_today    ? #2266cc
             : root.day_data.in_month    ? #d6d6d6
             : #bbbbbb;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Cells that will be present in the Yearly view
component MonthCellButton inherits Rectangle {

    in property <MonthCell> month_data;
    callback month_clicked(int);

    border-radius: 15px;
    border-color: Math.mod(root.month_data.month-num, 2) == 0 ? #272727 : #2d2d2d;
    border-width: 1px;

    // TODO add more cases for is_today & has_hover etc
    background: root.month_data.is_selected                 ? #4A90E2
              : root.month_data.is_current                  ? #ddeeff
              : ta.has_hover                                ? #1258a2
              : Math.mod(root.month_data.month-num, 2) == 0 ? #272727
              : transparent;
    
    ta := TouchArea { clicked => { root.month_clicked(root.month_data.month-num); } }

    // TODO add more cases for is_today & has_hover etc
    VerticalLayout {

        // Twelve of these sit side by side, so every pixel of padding here is twelve
        // pixels of minimum width on the window. Kept to the low end of the 5 to 15
        // range the rest of the calendar uses.
        padding: 5px;
        spacing: 2px;

        Text {
            text: root.month_data.month_num;
            font-size: 13px;
            vertical-stretch: 0;
            color: root.month_data.is_selected ? white
                : root.month_data.is_current  ? #2266cc
                : root.month_data.in_year     ? #a0a0a0
                : #bbbbbb;
            horizontal-alignment: center;
            vertical-alignment: top;

            
        }

        @children
    }
    
}


// Cells that will be present in the daily view, if an event is present
// Can span multiple hours
component EventCellButton inherits Rectangle {
    
}

// TODO change to ScrollView? prolly want custom scroll graphic
// TODO add the events logic
component DailyView inherits Rectangle {

    in property <length> hour_cell_width: 300px;
    in property <string> current_date: "Test Date";

    in property <[EventCell]> events_list;

    function hour_clicked(hour: int, day: int, month: int, year: int) {
        Global-Calendar-Callback.daily_hour_clicked();
    }

    outer_hour := VerticalLayout {
        padding: 10px;

        date := Text {
            vertical-stretch: 0;
            color: white;
            text: current_date;
            vertical-alignment: center;
            horizontal-alignment: left;
            max-height: 50px;
        }

        hours_layout := VerticalLayout {

            // The hours take the height, not the date above them. Worth stating even
            // though there are only two children: a layout whose children all report a
            // stretch of 0 does not leave the extra space alone, it splits it equally
            // between them, so the date line would grow at the same rate as the whole
            // day. The 24 cells inside are left at 0 precisely for that reason: equal
            // shares is what an hour grid wants.
            vertical-stretch: 1;
            spacing: 2px;

            for h in 24 : HourCellButton {
                hour_data: {
                    hour_num: h+1, 
                    hour_type: HourStampType.Army,
                    time_signature: "test",
                    is_selected: false,
                    is_current: false,
                };

                preferred-width: hour_cell_width;

                drop-shadow-offset-y: 2px;
                drop-shadow-color: #5e5e5f;

                hour_clicked => { hour_clicked(h, 1, 1, 2026) } // HACK hardcoded everything lmao
            }
        }
    }
}

component MonthlyView inherits Rectangle {

    in property <length> day_cell_dims: 50px;
    in property <int> current_month: 1;
    in property <string> current_date_string: "Test Date";

    pure function get_monthly_day_count(month: int, leap_year: bool) -> int {
        return  month == 1  ? 31 
              : month == 3  ? 31
              : month == 4  ? 30
              : month == 5  ? 31
              : month == 6  ? 30
              : month == 7  ? 31
              : month == 8  ? 31
              : month == 9  ? 30
              : month == 10 ? 31
              : month == 11 ? 30
              : month == 12 ? 31
              : leap-year   ? 29 : 28;
    }

    function day_clicked(day: int, month: int, year: int) {
        Global-Calendar-Callback.month_date_clicked();
    }

    outer_month := VerticalLayout {
        padding: 5px;
        padding-bottom: 10px;

        days_grid := GridLayout {

            vertical-stretch: 1;
            preferred-width: day_cell_dims * 7 + 5px;
            preferred-height: day_cell_dims * 6 + 5px;

            date := Text {

                col: 1;
                colspan: 4;
                row: 0;
                font-weight: FontWeight.semi-bold;
                font-size: 15px;
                letter-spacing: 1px;
                text: current_date_string;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: #a4a4a4;
                overflow: elide;
                wrap: no-wrap;
            }

            for days_list[d] in ["M", "T", "W", "T", "F", "S", "S"] : Text {
                col: d;
                row: 1;

                font-weight: FontWeight.semi-bold;
                font-size: 15px;
                vertical-alignment: center;
                horizontal-alignment: center;
                preferred-width: day_cell_dims;
                preferred-height: day_cell_dims;
                text: days_list;
                color: #a4a4a4;
            }

            // TODO faulty, error prone, change it to per month day count
            for days[d] in get_monthly_day_count(current_month, false) : DayCellButton {
                col: Math.mod((d), 7);
                row: ((d) / 7) + 2;

                // A grid row takes the smallest stretch among its cells, so marking the
                // day cells is what keeps the two header rows above at their own height
                // instead of growing along with the dates.
                vertical-stretch: 1;

                preferred-width: day_cell_dims;
                preferred-height: day_cell_dims;

                day_clicked => { day_clicked(d, current_month, 2026) } // HACK hardcoded year

                day_data: {
                    day_num: (d+1),
                    in_month: true,
                    is_today: false,
                };
            }
        }

        
    }
}

component YearlyView inherits Rectangle {
    
    in property <int> current_year;
    // The floor for one day cell, not the size it stays at: the grids below hand out
    // whatever the window has spare on top of this. Small, because a whole year is
    // 366 of them and the monthly view is where a date is meant to be comfortable.
    in property <length> day_cell_dims: 12px;
    // Sized off the cell so the two stay in proportion. Override it on its own if the
    // digits want to be bigger or smaller than the cell implies. Note that this does
    // not follow the window: the cells grow, the digits stay put.
    in property <length> day_font_size: day_cell_dims * 0.8;
    in property <bool> show_day_numbers: true;

    pure function get_monthly_day_count(month: int, leap_year: bool) -> int {
        return  month == 1  ? 31 
              : month == 3  ? 31
              : month == 4  ? 30
              : month == 5  ? 31
              : month == 6  ? 30
              : month == 7  ? 31
              : month == 8  ? 31
              : month == 9  ? 30
              : month == 10 ? 31
              : month == 11 ? 30
              : month == 12 ? 31
              : leap-year   ? 29 : 28;
    }

    function month_clicked(month_index: int, year: int) {
        Global-Calendar-Callback.year_month_clicked();
    }

    function day_clicked(day_index: int, month: int, year: int) {
        Global-Calendar-Callback.year_date_clicked();
    }


    outer_layout := VerticalLayout {

        // No `alignment`. An alignment other than the default stretch hands every child
        // its preferred size and parks the leftover space at one end, which is why the
        // grid below used to sit in the top corner with the rest of the panel empty
        // underneath it. Left as stretch, the year text keeps its natural height (a Text
        // does not stretch) and the grid takes everything else.
        spacing: 5px;

        year_text := Text {
            text: current_year;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        months_grid := GridLayout {

            // Takes the panel's height rather than sharing it with the year label.
            vertical-stretch: 1;
            spacing: 5px;
            padding: 5px;

            // Four across, three down. Three across is the more usual shape for a year
            // at a glance, but it is a third taller, and height is the scarce dimension
            // on this page: the day view next door is 24 hours tall on its own.
            for months[m] in ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] : MonthCellButton {

                col: Math.mod(m, 3);
                row: m / 3 ;

                // Nothing sized here. The day cells state a minimum, the grid around
                // them adds it up, and the month cell inherits the total plus its own
                // label and padding. Writing it out by hand a second time only creates
                // something that can disagree with the cells it is meant to describe.

                month_data: {
                    month_num: m+1,
                    in_year: true,
                    is_current: false,
                };

                month_clicked => { month_clicked(m, 2026) } // HACK hardcoded year

                days_grid := GridLayout {

                    // And the days take the month cell's height rather than sharing it
                    // with the month number above them.
                    vertical-stretch: 1;

                    for days[d] in get_monthly_day_count(m+1, false) : DayCellButton {
                        col: Math.mod((d), 7);
                        row: (d) / 7 ;

                        visible_days_num: root.show_day_numbers;
                        day_font_size: root.day_font_size;

                        // Minimum rather than preferred. A preferred size is what an
                        // element settles at when the layout has space to spare, so the
                        // cells sat at their 12px ideal and left the panel half empty;
                        // as a minimum it is the floor they shrink to and the grid
                        // spends the surplus on them instead.
                        min-height: day_cell_dims;
                        min-width: day_cell_dims;

                        day_clicked => { day_clicked(d, m, 2026) } // HACK hardcoded year

                        day_data: {
                            day_num: (d+1),
                            in_month: true,
                            is_today: false,
                        };
                    }
                }
            }
        }
    }
}

struct UpcomingEventsCell {

    event_date: string,
    event_title: string,
    event_type: string, // TODO this will be changed to a user defined enum
    event_index: int,
    is_today: bool,
